root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{c,h}]
indent_size = 4
max_line_length = 110

[{CMakeLists.txt,*.cmake,*.cmake.in,CMakePresets.json}]
indent_size = 4

[*.{yml,json}]
indent_size = 2

[tests/snapshots/*]
trim_trailing_whitespace = false
insert_final_newline = false
